{
  "name": "repolens",
  "version": "0.1.0",
  "description": "Structure-aware code retrieval for AI coding agents. An MCP server that indexes a repository and returns the smallest slice that answers the question.",
  "type": "module",
  "bin": {
    "repolens": "./src/cli.js"
  },
  "scripts": {
    "index": "node src/cli.js index",
    "search": "node src/cli.js search",
    "mcp": "node src/cli.js mcp",
    "stats": "node src/cli.js stats",
    "test": "node --test",
    "eval": "node eval/run.js",
    "eval:multi": "node eval/multirepo.js",
    "coverage": "node tools/coverage.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "code-search",
    "retrieval",
    "ai-agent",
    "sqlite",
    "fts5"
  ],
  "license": "MIT",
  "dependencies": {}
}
